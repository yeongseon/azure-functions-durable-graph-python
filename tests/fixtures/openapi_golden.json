{
  "components": {
    "schemas": {
      "CancelRunRequest": {
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CheckStatusResponse": {
        "additionalProperties": true,
        "description": "Azure Durable Functions check-status payload (management URLs). Shape is owned by the durable SDK and is intentionally open.",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Shared error payload for HTTP error responses.\n\nProvides a single, consistent shape for all error returns instead of\nad-hoc ``{\"error\": ...}`` dicts, aligning with the sibling langgraph\npackage's platform error contract.",
        "properties": {
          "details": {},
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "EventAcceptedResponse": {
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "event_name": {
            "type": "string"
          },
          "instance_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RegisteredGraphs": {
        "items": {
          "type": "object"
        },
        "type": "array",
        "x-afdg-graphs": []
      },
      "RunCancelledResponse": {
        "properties": {
          "instance_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "terminated": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "RunStatusEnvelope": {
        "properties": {
          "custom_status": {},
          "input": {},
          "instance_id": {
            "type": "string"
          },
          "output": {},
          "runtime_status": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "instance_id"
        ],
        "type": "object"
      },
      "StartGraphRunRequest": {
        "description": "Wire body for starting a graph run. The server injects graph_name/graph_hash; only these fields are client-supplied.",
        "properties": {
          "input": {
            "type": "object"
          },
          "instance_id": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "azure-functions-durable-graph runtime",
    "version": "<VERSION>"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/graphs/{graph_name}/runs": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "graph_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartGraphRunRequest"
              }
            }
          },
          "required": false
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckStatusResponse"
                }
              }
            },
            "description": "Run accepted; durable check-status URLs."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid or malformed request body."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unknown graph."
          }
        },
        "summary": "Start a graph run"
      }
    },
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Health"
      }
    },
    "/api/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "OpenAPI document"
      }
    },
    "/api/runs/{instance_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatusEnvelope"
                }
              }
            },
            "description": "Current run status."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Instance not found."
          }
        },
        "summary": "Get run status"
      }
    },
    "/api/runs/{instance_id}/cancel": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRunRequest"
              }
            }
          },
          "required": false
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunCancelledResponse"
                }
              }
            },
            "description": "Run cancellation accepted."
          }
        },
        "summary": "Terminate a run"
      }
    },
    "/api/runs/{instance_id}/events/{event_name}": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "event_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": false
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAcceptedResponse"
                }
              }
            },
            "description": "Event accepted."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request body present but is not valid JSON."
          }
        },
        "summary": "Raise an external event"
      }
    }
  }
}
